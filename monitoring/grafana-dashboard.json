{
  "dashboard": {
    "id": null,
    "uid": "customer-success-fte",
    "title": "Customer Success FTE - Operations Dashboard",
    "tags": ["fte", "customer-success", "production"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "API Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"fte-api\"}[5m])) by (method, endpoint)",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "P95 Response Latency",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"fte-api\"}[5m]))",
            "legendFormat": "P95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 2 },
                { "color": "red", "value": 3 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Channel Message Volume",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(increase(messages_received_total[1h])) by (channel)",
            "legendFormat": "{{channel}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Tickets Created vs Escalated",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "rate(tickets_created_total[5m])",
            "legendFormat": "Created"
          },
          {
            "expr": "rate(tickets_escalated_total[5m])",
            "legendFormat": "Escalated"
          }
        ]
      },
      {
        "id": 5,
        "title": "Escalation Rate (%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "rate(tickets_escalated_total[1h]) / rate(tickets_created_total[1h]) * 100",
            "legendFormat": "Escalation Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 15 },
                { "color": "red", "value": 25 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Response Delivery Success Rate",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "(1 - rate(response_delivery_failures_total[5m]) / rate(response_delivery_total[5m])) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 95 },
                { "color": "green", "value": 99 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Rate Limit Hits",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
        "targets": [
          {
            "expr": "sum(increase(rate_limit_exceeded_total[1h]))",
            "legendFormat": "Rate Limit Hits (1h)"
          }
        ]
      },
      {
        "id": 8,
        "title": "Service Health",
        "type": "stat",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "up",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
              { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
            ]
          }
        }
      },
      {
        "id": 9,
        "title": "Kafka Consumer Lag",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "kafka_consumergroup_lag_sum",
            "legendFormat": "{{consumergroup}} - {{topic}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "PostgreSQL Active Connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "Active Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 60 },
                { "color": "red", "value": 80 }
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Redis Memory Usage",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100",
            "legendFormat": "Memory Usage"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Average Sentiment Score",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
        "targets": [
          {
            "expr": "avg(sentiment_score) by (channel)",
            "legendFormat": "{{channel}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.3 },
                { "color": "green", "value": 0.6 }
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "title": "Message Processing Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      }
    ]
  }
}
